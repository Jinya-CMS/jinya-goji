{
  "name": "jinya-cms",
  "version": "26.3.1",
  "description": "Jinya Gallery CMS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jinya-CMS/jinya-cms-goji.git"
  },
  "author": "Jinya Developers",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Jinya-CMS/jinya-cms-goji/issues"
  },
  "type": "module",
  "scripts": {
    "designer:prettier": "prettier static/designer/js static/designer/css static/designer/templates --check",
    "designer:eslint": "eslint -c eslint.config.cjs static/designer/js/ static/designer/lang/",
    "designer:stylelint": "stylelint static/designer/**/*.css",
    "designer:format": "prettier static/designer/js static/designer/css static/designer/templates --write",
    "designer:lint": "bun run designer:prettier && bun run designer:eslint && bun run designer:stylelint",
    "installer:prettier": "prettier static/installer --check",
    "installer:eslint": "eslint -c eslint.config.cjs static/installer/",
    "installer:stylelint": "stylelint static/installer/**/*.css --fix",
    "installer:format": "prettier static/installer --write",
    "installer:lint": "bun run installer:prettier && bun run installer:eslint && bun run installer:stylelint",
    "lint": "bun run designer:lint && bun run installer:lint"
  },
  "homepage": "https://jinya.de",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0"
  }
}
